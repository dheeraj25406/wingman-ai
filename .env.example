# ==============================================================================
# Wingman AI - Environment Configuration Example
# ==============================================================================

# Gemini LLM Provider (Google Gen AI SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Backend Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL with SQLite fallback for local test/dev)
DATABASE_URL=sqlite+aiosqlite:///./wingman.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wingman

# Observability Integrations
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Qdrant Vector Store
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_STORAGE_PATH=./qdrant_storage

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=./mlruns
