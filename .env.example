# ==============================================================================
# WINGMAN AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure the values for your deployment.
# NEVER commit .env to version control.

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & NETWORKING
# ------------------------------------------------------------------------------
# Set to 'production' for live deployment, 'development' for local debugging
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# Comma-separated list of allowed CORS origins for the frontend UI
# In production, replace with your public domain (e.g., https://wingman.example.com)
CORS_ORIGINS=http://localhost:3000,http://localhost:5180,http://localhost:80,https://wingman.example.com

# ------------------------------------------------------------------------------
# 2. SECURITY & ACCESS CONTROL
# ------------------------------------------------------------------------------
# Mandatory admin key to protect remediation approvals, fault injections, and settings in production
# In local development mode, leaving it blank allows open demonstration mode
ADMIN_API_KEY=your_admin_secret_key_here

# Rate Limiting configuration (requests per minute per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_SENSITIVE_PER_MINUTE=20

# ------------------------------------------------------------------------------
# 3. AI / LLM CONFIGURATION (GOOGLE GEN AI)
# ------------------------------------------------------------------------------
# Required for autonomous incident investigation and root-cause hypothesis generation
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=15.0

# ------------------------------------------------------------------------------
# 4. DATABASE & PERSISTENCE
# ------------------------------------------------------------------------------
# Production PostgreSQL connection string (asyncpg driver required):
DATABASE_URL=postgresql+asyncpg://wingman:your_secure_password_here@postgres:5432/wingman

# Local SQLite connection string fallback:
# DATABASE_URL=sqlite+aiosqlite:///./wingman.db

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=wingman
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=wingman

# ------------------------------------------------------------------------------
# 5. OBSERVABILITY & TELEMETRY CONNECTORS (OPTIONAL)
# ------------------------------------------------------------------------------
# Wingman AI includes an embedded distributed microservice telemetry simulator.
# In production environments with external telemetry stacks, point to your clusters:
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
TEMPO_URL=http://tempo:3200
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# ------------------------------------------------------------------------------
# 6. VECTOR STORAGE & ML RUNS
# ------------------------------------------------------------------------------
QDRANT_STORAGE_PATH=./qdrant_storage
MLFLOW_TRACKING_URI=./mlruns
